{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": { "DataDirectory": "./data", "DatabaseFileName": "tcri.db" },
  "Graph": { "TenantId": "11111111-1111-4111-8111-111111111111", "RetentionDays": 30 },
  "Inbox": { "MaxPending": 10000 },
  "Processing": { "Workers": 2, "LeaseSeconds": 120, "RetrySchedule": "1,5,15,60", "PendingLimitHours": 4, "SuspendedRecheckHours": 24, "MaxAttempts": 10 },
  "Reconcile": { "IntervalMinutes": 15, "LookbackHours": 24 },
  "Api": { "Key": "demo-only-key-change-me", "MaxPageSize": 100 },
  "Webhook": { "MaxBodyBytes": 1048576, "MaxBatchItems": 100, "ClientState": "demo-only-client-state" },
  "Demo": { "Enabled": true },
  "Outbox": { "MaxAttempts": 8, "LeaseSeconds": 120, "BackoffSeconds": "30,120,600,1800,3600", "MaxAgeHours": 24 }
}
